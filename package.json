{
  "name": "factormaker",
  "version": "1.5.1",
  "description": "پنل تحت وب صدور پیش‌فاکتور و فاکتور فروش (فارسی، RTL) با PDF، بایگانی، Excel و ارسال به تلگرام/بله/ایتا",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "backup": "node scripts/backup.js",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "jalaali-js": "^2.0.1",
    "puppeteer": "^25.13.0",
    "socks": "^2.8.10",
    "undici": "^8.11.2",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
